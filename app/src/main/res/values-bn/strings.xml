    <!-- Terms of Use -->
    <string name="terms_acceptable_use_title">১. গ্রহণযোগ্য ব্যবহার</string>
    <string name="terms_acceptable_use_body">PromptLens ব্যক্তিগত ও সৃজনশীল ব্যবহারের জন্য ফটোগ্রাফি অনুপ্রেরণা এবং ইমেজ-জেনারেশন প্রম্পট প্রদান করে। সেবার অপব্যবহার, কনটেন্ট স্ক্র্যাপ বা অ্যাপের কার্যক্রমে বিঘ্ন ঘটাবেন না।</string>
    <string name="terms_comments_rules_title">২. মন্তব্যের নিয়মাবলী</string>
    <string name="terms_comments_rules_body">মন্তব্যে সর্বদা শ্রদ্ধাশীল ও গঠনমূলক থাকুন। স্প্যাম, হয়রানি, ঘৃণামূলক বক্তব্য বা আপত্তিকর মন্তব্য সম্পূর্ণ নিষিদ্ধ এবং তা মুছে ফেলা হবে। ব্যবহারকারীরা যেকোনো সময় আপত্তিকর মন্তব্য রিপোর্ট করতে বা অন্য ব্যবহারকারীকে ব্লক করতে পারবেন।</string>
    <string name="terms_content_rights_title">৩. কনটেন্টের অধিকার</string>
    <string name="terms_content_rights_body">প্রদর্শিত সকল রেফারেন্স ছবি, শিরোনাম এবং প্রম্পট PromptLens এবং সংশ্লিষ্ট নির্মাতাদের সম্পত্তি। আপনার নিজস্ব সৃজনশীল কাজের জন্য প্রম্পট কপি ও শেয়ার করা যাবে।</string>
