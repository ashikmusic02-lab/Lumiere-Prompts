    <string name="terms_acceptable_use_title">১. গ্রহণযোগ্য ব্যবহার</string>
    <string name="terms_acceptable_use_body">PromptLens ব্যক্তিগত এবং সৃজনশীল ব্যবহারের জন্য ফটোগ্রাফি অনুপ্রেরণা এবং প্রম্পট প্রদান করে। সেবাটির অপব্যবহার বা অ্যাপের কার্যক্রমে বিঘ্ন ঘটানোর চেষ্টা করবেন না।</string>
