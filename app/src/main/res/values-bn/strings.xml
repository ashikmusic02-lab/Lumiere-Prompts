    <string name="terms_content_rights_title">৩. কনটেন্ট অধিকার</string>
    <string name="terms_content_rights_body">প্রদর্শিত সমস্ত ছবি, শিরোনাম এবং প্রম্পট PromptLens এবং সংশ্লিষ্ট নির্মাতাদের সম্পত্তি। আপনার নিজস্ব সৃজনশীল কাজের জন্য প্রম্পট কপি ও শেয়ার করা যাবে।</string>
