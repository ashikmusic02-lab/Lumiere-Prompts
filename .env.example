# Lumiere Prompts — External Service Configuration
# Configure these values in the AI Studio Secrets panel (.env) before building for production.
# NOTE: Never place OneSignal REST API keys or Firebase Admin SDK private keys here.

# OneSignal Push Notification App ID (Public Client App ID from OneSignal Dashboard)
ONESIGNAL_APP_ID=YOUR_ONESIGNAL_APP_ID

# Firebase App Check Debug Token (Optional: used in debug builds to register in Firebase Console -> App Check)
FIREBASE_APPCHECK_DEBUG_TOKEN=YOUR_APPCHECK_DEBUG_TOKEN

# Google AdMob Ad Unit IDs (Replace with your production AdMob Unit IDs from AdMob Console)
ADMOB_BANNER_AD_UNIT_ID=YOUR_ADMOB_BANNER_AD_UNIT_ID
ADMOB_REWARDED_AD_UNIT_ID=YOUR_ADMOB_REWARDED_AD_UNIT_ID
ADMOB_INTERSTITIAL_AD_UNIT_ID=YOUR_ADMOB_INTERSTITIAL_AD_UNIT_ID

# Configurable Official Google Play Store Link appended to shared prompts
OFFICIAL_PLAY_STORE_URL=YOUR_OFFICIAL_PLAY_STORE_URL
